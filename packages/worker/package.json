{
  "name": "@flarelytics/worker",
  "version": "0.2.0",
  "private": true,
  "description": "Flarelytics analytics worker for Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "setup": "bash setup.sh",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "predeploy": "npm --prefix ../tracker run build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@flarelytics/tracker": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250312.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
